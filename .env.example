# DevFlow Environment Configuration
#
# 复制为 .env 并填入真实 API Key：
#   cp .env.example .env

# LLM Provider (openai / deepseek / chatanywhere)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# API Keys — 至少填一个
OPENAI_API_KEY=sk-xxx
DEEPSEEK_API_KEY=sk-xxx
CHATANYWHERE_API_KEY=sk-xxx

# API Base URLs
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CHATANYWHERE_BASE_URL=https://api.chatanywhere.tech/v1
# Use the system HTTP(S) proxy when the provider requires it. Set false only
# on a network that can reach the provider directly.
LLM_TRUST_ENV=true
# The workflow controls retries and timeouts; avoid hidden SDK retries.
LLM_MAX_RETRIES=0

# Server
HOST=0.0.0.0
PORT=8000

# Database (sqlite for development)
DATABASE_URL=sqlite:///devflow.db

# LangGraph task persistence: memory for local development; postgres for restart recovery
CHECKPOINTER_BACKEND=memory
CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow

# Sandbox mode: local (default, no dependencies) | docker (isolated, requires Docker Desktop)
SANDBOX_MODE=local
SANDBOX_TIMEOUT_SECONDS=300

# Docker (only used when SANDBOX_MODE=docker)
DOCKER_IMAGE=python:3.11
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPUS=1

# Agent defaults
# DEVFLOW_USE_MOCK=true  改为 false 启用真实 LLM 调用
DEVFLOW_USE_MOCK=false
DEVFLOW_USE_SANDBOX=false  改为 false 启用真实沙箱（不设则跟随 DEVFLOW_USE_MOCK）
MAX_ITERATIONS=3
AGENT_TIMEOUT_SECONDS=120
# Task-wide controls (0 budget means unlimited)
TASK_TIMEOUT_SECONDS=900
TASK_BUDGET_USD=0
# SSE checkpoint polling interval for live event streams
SSE_POLL_INTERVAL_MS=500

# Debug
DEVFLOW_DEBUG_CONTEXT=0
LOG_LEVEL=INFO
